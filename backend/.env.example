PORT=10000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/campuslaugh?retryWrites=true&w=majority
FRONTEND_URL=https://app.example.com
# Set true when running behind one trusted reverse proxy/load balancer.
TRUST_PROXY=true
# Generate independent 32+ character random values; never reuse or commit real secrets.
JWT_ACCESS_SECRET=<generate-a-random-access-secret-at-least-32-characters>
JWT_REFRESH_SECRET=<generate-a-different-refresh-secret-at-least-32-characters>
# Uploads are disabled until all three values are configured.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
# Password recovery requires all SMTP values; otherwise the UI gives an explicit setup error.
EMAIL_HOST=<smtp-host>
EMAIL_PORT=587
EMAIL_USER=<smtp-user>
EMAIL_PASSWORD=<smtp-password>
EMAIL_FROM=no-reply@example.com
PASSWORD_RESET_URL=https://app.example.com/#/reset-password

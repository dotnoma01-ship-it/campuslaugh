PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/campuslaugh
FRONTEND_URL=http://localhost:5173
# Generate two distinct random secrets with at least 32 characters for local use.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
# Leave all three blank to disable uploads, or supply all values from Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
